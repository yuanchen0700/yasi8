# brand9 (雅思口语) server configuration
# Copy this file to .env and fill in real values.

# Resend API key for verification-code emails (required for registration).
# When unset, falls back to SMTP (admin-configured QQ mailbox in the panel).
RESEND_API_KEY=

# From address (must be a verified sender on your Resend account)
BRAND9_MAIL_FROM=onboarding@resend.dev

# Optional: override Resend API endpoint (default https://api.resend.com/emails)
# RESEND_ENDPOINT=https://api.resend.com/emails

# Optional: override port (default 8996)
# BRAND9_PORT=8996
